<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>default</LangVersion>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
    </PropertyGroup>

    <PropertyGroup>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>RecycleBinToolkit</PackageId>
        <Title>RecycleBinToolkit</Title>
        <Copyright>Copyright (c) 2026 Denis Tulupov</Copyright>
        <Authors>Denis Tulupov</Authors>
        <PackageProjectUrl>https://github.com/viruseg/RecycleBinToolkit</PackageProjectUrl>
        <RepositoryUrl>https://github.com/viruseg/RecycleBinToolkit</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>recycle-bin trash delete restore empty windows filesystem</PackageTags>
        <Description>A high-performance .NET library for the Windows Recycle Bin: move files and directories into it, list what is in it, restore entries, empty it, and report the outcome of every item. It reads and writes the Recycle Bin's own files — no SHFileOperation, no IFileOperation, no COM.</Description>
        <PackageReleaseNotes>
            1.2.0: Progress reporting on RecycleAsync, RestoreAsync and EmptyAsync — each settings type carries OnItemProcessed, OnProgressFailed and WaitForProgressCallbacks, and each handler is given a RecycleProgress, a RestoreProgress or an EmptyProgress. EmptyAsync gains an overload taking EmptyOptions
            1.1.0: Support for the first version of the Recycle Bin index file, on machines whose Windows reads that one rather than the second
            1.0.0: First release
        </PackageReleaseNotes>
        <Version>1.2.0</Version>
        <AssemblyVersion>1.2.0</AssemblyVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <IncludeContentInPack>true</IncludeContentInPack>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../../LICENSE" Pack="true" Visible="true" PackagePath="" />
        <None Include="../../../README.md" Pack="true" Visible="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.346">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="RecycleBinToolkit.Tests" />
    </ItemGroup>
</Project>
