<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>default</LangVersion>
        <!-- The library documents its public surface in prose, and without this none of it is checked:
             a malformed comment, a param for a parameter that does not exist and an unresolvable cref
             are all silent. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- A warning nobody has to read is a warning nobody reads. The whole surface is
             source-generated COM and interop, so the analyzers that know about those have something to
             say here, and the compiler's own suggestions are part of what is being checked. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

        <!-- The AOT analyzer is on, the trim analyser is not: this library is COM from top to bottom and
             the trimming analyser's verdict on it ("correctness of COM interop cannot be guaranteed")
             is a property of COM rather than something a consumer's publish settings can fix. -->
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.346">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="RecycleBinToolkit.Tests" />
    </ItemGroup>
</Project>
